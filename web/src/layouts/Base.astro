---
import "../styles/global.css";

interface Props {
  readonly title: string;
  readonly description: string;
  /** Full-width page: the page lays out its own `.wrap` sections instead of sitting inside one. */
  readonly wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
const home = import.meta.env.BASE_URL;
const base = home.replace(/\/$/, "");
const anatomy = `${base}/anatomy/`;
// Prices (home and every GPU page) vs the explainer: highlights the current section in the header.
const onAnatomy = Astro.url.pathname.replace(/\/?$/, "/") === anatomy;
const links = [
  { href: home, label: "USD / GPU-hour", current: !onAnatomy },
  { href: anatomy, label: "What is a GPU-hour?", current: onAnatomy },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // Apply a saved light/dark choice before first paint (see src/lib/theme.ts).
      try {
        const t = localStorage.getItem("dkw-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..800&display=swap"
    />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href={home} aria-label="DKW home">DKW</a>
        <nav class="nav" aria-label="Site">
          {links.map((l) => (
            <a href={l.href} aria-current={l.current ? "page" : undefined}>{l.label}</a>
          ))}
          <button class="theme" id="theme-toggle" type="button" aria-label="Switch between light and dark mode">
            <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
            </svg>
            <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" />
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main class={wide ? undefined : "wrap"}>
      <slot />
    </main>
  </body>
</html>

<script>
  import { applyTheme, currentTheme, otherTheme } from "../lib/theme";

  const root = document.documentElement;
  const dark = matchMedia("(prefers-color-scheme: dark)");
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    applyTheme(root, otherTheme(currentTheme(root, dark.matches)));
  });
</script>

<style>
  .top { border-bottom: 1px solid var(--line); view-transition-name: site-header; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 76px; padding-bottom: 0; }
  .brand { font-weight: 800; font-size: 30px; letter-spacing: -0.04em; line-height: 1; text-decoration: none; }
  .nav { display: flex; align-items: center; gap: 6px; }
  .nav a {
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    color: var(--muted);
    padding: 8px 14px;
    border-radius: 999px;
    transition: background-color 120ms ease-out, color 120ms ease-out;
  }
  .nav a:hover { color: var(--text); background: var(--hover); }
  .nav a[aria-current="page"] { color: var(--text); background: var(--hover); }
  .theme {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin-left: 6px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--text);
    cursor: pointer;
    transition: background-color 120ms ease-out;
  }
  .theme:hover { background: var(--hover); }
  .theme svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  @media (max-width: 520px) {
    .bar { height: 64px; gap: 8px; }
    .brand { font-size: 24px; }
    .nav { gap: 2px; }
    .nav a { font-size: 13px; padding: 6px 8px; }
    .theme { width: 32px; height: 32px; margin-left: 2px; }
  }
</style>
