---
import "../styles/global.css";
import { TZ_LABEL } from "../lib/format";

interface Props {
  readonly title: string;
  readonly description: string;
}
const { title, description } = Astro.props;
const home = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href={home}>DKW</a>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap credit">
      Data: <a href="https://github.com/getcomputable/gpu-index">Computable GPU Index</a>, CC BY-NC 4.0 ·
      all times Dubai ({TZ_LABEL}, UTC+4)
    </footer>
  </body>
</html>

<style>
  .top { border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 56px; padding-bottom: 0; }
  .brand { font-weight: 700; font-size: 17px; letter-spacing: -0.01em; text-decoration: none; }
  .credit { color: var(--muted); font-size: 12px; padding-top: 0; }
</style>
